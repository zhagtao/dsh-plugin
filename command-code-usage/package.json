{
  "name": "dsh-command-code-usage",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Command Code plan usage in the DeepSeek Harness (DSH) account menu.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "command-code",
    "goat",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhagtao/dsh-plugin.git",
    "directory": "command-code-usage"
  },
  "homepage": "https://github.com/zhagtao/dsh-plugin/tree/main/command-code-usage#readme",
  "bugs": {
    "url": "https://github.com/zhagtao/dsh-plugin/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
